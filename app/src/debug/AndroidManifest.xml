<?xml version="1.0" encoding="utf-8"?>
<!-- debug 빌드에만 합쳐지는 매니페스트. release(제출용)에는 이벤트 주입이 없음 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.runningtale.DEBUG_EVENT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
