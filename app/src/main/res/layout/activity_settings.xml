<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="48dp"
        android:paddingEnd="96dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#1B1B1B"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_note"
            android:textColor="#666666"
            android:textSize="22sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_name" />

        <EditText
            android:id="@+id/name"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:hint="@string/settings_name_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLength="6"
            android:textColor="#1B1B1B"
            android:textColorHint="#9E9E9E"
            android:textSize="32sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_seat" />

        <RadioGroup
            android:id="@+id/seat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/seat_left"
                style="@style/SettingsChoice"
                android:text="@string/settings_seat_left" />

            <RadioButton
                android:id="@+id/seat_right"
                style="@style/SettingsChoice"
                android:layout_marginStart="48dp"
                android:text="@string/settings_seat_right" />
        </RadioGroup>

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/settings_effects" />

        <Switch
            android:id="@+id/fan"
            style="@style/SettingsChoice"
            android:layout_width="720dp"
            android:text="@string/settings_fan" />

        <Switch
            android:id="@+id/light"
            style="@style/SettingsChoice"
            android:layout_width="720dp"
            android:layout_marginTop="16dp"
            android:text="@string/settings_light" />

        <Button
            android:id="@+id/save"
            android:layout_width="320dp"
            android:layout_height="96dp"
            android:layout_marginTop="48dp"
            android:backgroundTint="#2F80C8"
            android:text="@string/settings_save"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />
    </LinearLayout>
</ScrollView>
