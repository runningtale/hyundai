<?xml version="1.0" encoding="utf-8"?>
<!-- 아이 이름은 이 차 안에만 저장: 클라우드 백업과 기기 간 이전에서 모두 뺌 (Android 12 이상) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
